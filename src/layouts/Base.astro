---
import '@fontsource/inter-tight/latin-300.css';
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Amber Stapff — Creative Designer, Graphic Producer & Event Stylist. Pitch decks, global events and brand experiences.' } = Astro.props;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /* On screens wider than the design width, scale the whole page up proportionally (like michabrandt.de) instead of leaving empty margins. */
      (function () {
        var base = 1680, d = document.documentElement;
        function fit() { var w = window.innerWidth; d.style.zoom = w > base ? (w / base).toFixed(4) : ''; }
        fit(); window.addEventListener('resize', fit);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
