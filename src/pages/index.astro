---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings, getProjects, projectUrl } from '../lib/content';

const s = await getSettings();
const projects = await getProjects();
// Every homepage cover is shown landscape (5:3); "Crop focus" picks which part of the image stays in frame.
const focus = { center: '50% 50%', top: '50% 15%', bottom: '50% 85%', left: '20% 50%', right: '80% 50%' } as const;
// Two portrait projects next to each other in the order share one row; a lone portrait shows as a normal landscape row.
type Row = { kind: 'single'; p: (typeof projects)[number] } | { kind: 'pair'; a: (typeof projects)[number]; b: (typeof projects)[number] };
const rows: Row[] = [];
for (let i = 0; i < projects.length; i++) {
  const p = projects[i], n = projects[i + 1];
  if (p.data.home_layout === 'portrait' && n?.data.home_layout === 'portrait') { rows.push({ kind: 'pair', a: p, b: n }); i++; }
  else rows.push({ kind: 'single', p });
}
const sub = (p: (typeof projects)[number]) => [p.data.location, p.data.working_under && `Engaged by ${p.data.working_under}`].filter(Boolean).join(' · ');
const blurb = (p: (typeof projects)[number]) => (p.data.intro && !p.data.intro.startsWith('[') ? p.data.intro : p.data.summary);
const years = (a: (typeof projects)[number], b: (typeof projects)[number]) => [...new Set([a.data.year, b.data.year].filter(Boolean))].join(' / ');
---
<Base title={`${s.name} — Creative Designer, Graphic Producer & Event Stylist`}>
  <Header name={s.name} home />
  <main id="main">
    <section id="top" class="wrap wrap-wide hero">
      <h1 class="sr-only">{s.name}</h1>
      <div class="hero-row">
        <p class="lede">{s.positioning}</p>
        {s.meta.length > 0 && (
          <ul class="meta-list label">{s.meta.map((m) => <li>{m}</li>)}</ul>
        )}
      </div>
    </section>

    {(s.hero_image || s.hero_video) && (
      <section class="wrap wrap-wide" aria-label="Featured">
        <figure class="hero-figure">
          <div class="reel">
            {s.hero_image ? (
              <Image src={s.hero_image} alt={s.hero_caption ?? ''} widths={[1100, 1800, 2600]} sizes="(min-width: 1680px) 1580px, 100vw" loading="eager" fetchpriority="high" />
            ) : (
              <>
                <video
                  id="reel"
                  src={s.hero_video!.replace(/^\//, '')}
                  poster={s.hero_poster?.src}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={s.hero_caption ?? 'Showreel'}
                ></video>
                <button class="reel-toggle" type="button" id="reel-toggle" aria-pressed="false">Pause</button>
              </>
            )}
          </div>
          {(s.hero_caption || s.hero_caption_right) && (
            <figcaption class="caption-row label"><span>{s.hero_caption}</span><span>{s.hero_caption_right}</span></figcaption>
          )}
        </figure>
      </section>
    )}

    <section id="work" class="wrap wrap-wide work" aria-labelledby="work-title">
      <div class="section-head work-head">
        <h2 id="work-title">Selected Work</h2>
        <span class="label">({projects.length})</span>
      </div>
      {rows.map((r) => r.kind === 'single' ? (
        <article class="row4 project-row">
          <span class="label col-label">{r.p.data.year}</span>
          <div class="col-text">
            <h3 class="row-heading"><a href={projectUrl(r.p)}>{r.p.data.title}</a></h3>
            {blurb(r.p) && <p class="row-body">{blurb(r.p)}</p>}
            <a class="more" href={projectUrl(r.p)} aria-label={`View project: ${r.p.data.title}`}>View project →</a>
          </div>
          <a class="col-media" href={projectUrl(r.p)} tabindex="-1" aria-hidden="true">
            <Image
              class="media r-cover"
              src={r.p.data.cover}
              alt={r.p.data.cover_alt}
              widths={[640, 1100, 1600]}
              sizes="(min-width: 900px) 50vw, 100vw"
              style={`object-position: ${focus[r.p.data.cover_focus]}`}
            />
            <span class="caption"><span>{r.p.data.client ?? r.p.data.title}</span><small>{sub(r.p)}</small></span>
          </a>
        </article>
      ) : (
        <article class="row4 project-row pair-row">
          <span class="label col-label">{years(r.a, r.b)}</span>
          <div class="col-text pair-text">
            {[r.a, r.b].map((p) => (
              <div class="pair-item">
                <h3 class="row-heading"><a href={projectUrl(p)}>{p.data.title}</a></h3>
                {blurb(p) && <p class="row-body">{blurb(p)}</p>}
                <a class="more" href={projectUrl(p)} aria-label={`View project: ${p.data.title}`}>View project →</a>
              </div>
            ))}
          </div>
          {[r.a, r.b].map((p, i) => (
            <a class={`col-half ${i === 0 ? 'first' : 'second'}`} href={projectUrl(p)} tabindex="-1" aria-hidden="true">
              <Image
                class="media r-port"
                src={p.data.cover}
                alt={p.data.cover_alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 900px) 25vw, 50vw"
                style={`object-position: ${focus[p.data.cover_focus]}`}
              />
              <span class="caption"><span>{p.data.client ?? p.data.title}</span><small>{sub(p)}</small></span>
            </a>
          ))}
        </article>
      ))}
    </section>

    <section id="about" class="wrap about">
      <div class="section-head">
        <h2>About</h2>
        {s.about_label && <span class="label">{s.about_label}</span>}
      </div>
      <div class="about-body">
        {s.headshot && (
          <Image class="headshot" src={s.headshot} alt={`Portrait of ${s.name}`} widths={[300, 600]} sizes="300px" />
        )}
        <div class="about-copy">
          <p class="statement">{s.about_statement}</p>
          {s.stats.length > 0 && (
            <div class="stats">
              {s.stats.map((st) => (
                <div class="stat"><strong>{st.value}</strong><span>{st.label}</span></div>
              ))}
            </div>
          )}
          <div class="facts">
            {s.worked_with && <div class="fact"><span class="label">Worked with</span><p>{s.worked_with}</p></div>}
            {s.countries && <div class="fact"><span class="label">Projects across</span><p>{s.countries}</p></div>}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer s={s} />

  <script is:inline>
    (function () {
      var v = document.getElementById('reel');
      var b = document.getElementById('reel-toggle');
      if (!v || !b) return;
      function set(paused) { b.textContent = paused ? 'Play' : 'Pause'; b.setAttribute('aria-pressed', String(paused)); }
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.pause(); v.removeAttribute('autoplay'); set(true); }
      b.addEventListener('click', function () {
        if (v.paused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); set(false); }
        else { v.pause(); set(true); }
      });
    })();
  </script>
</Base>
